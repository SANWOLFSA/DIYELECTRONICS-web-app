# GEMINI_API_KEY: Required. SERVER-SIDE ONLY.
# Read by server.ts (process.env.GEMINI_API_KEY). All AI requests from the browser
# go through the Express API (/api/*), so the key is never shipped to the client.
# Do NOT prefix it with VITE_ - anything starting with VITE_ is bundled into the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase web config (public client config, safe to expose; used by src/lib/firebase.ts).
# If these are missing the app still loads, but sign-in and cloud sync are disabled.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Signed-in sessions (including guests) end after this many hours. Default 5.
VITE_SESSION_HOURS="5"

# Admin UI bootstrap (comma-separated emails). Listed emails SEE the Admin Desk, but every
# admin action is still rejected by firestore.rules / storage.rules until the account is a
# real admin (admins/{uid} doc, users/{uid}.role == "admin", or the admin custom claim).
# Leave empty in production once real admins are set up.
# sbheko1@gmail.com, diy.electronicsa@gmail.com and sanwolfza@gmail.com are always included (src/lib/admin.ts).
VITE_ADMIN_EMAILS=""
